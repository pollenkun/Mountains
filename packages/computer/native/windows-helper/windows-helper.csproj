<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built on the Mac with the .NET SDK by scripts/build-windows-helper.mjs; runs on the .NET Framework 4.8 every
       Windows 10/11 already has, as one AnyCPU exe (native on x64 and ARM64). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AssemblyName>mountains-windows-helper</AssemblyName>
    <RootNamespace>Mountains</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- One file to ship: no .pdb, and no .exe.config (a v4 exe runs on the installed 4.8 runtime without one). -->
    <DebugType>none</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PathMap>$(MSBuildProjectDirectory)=/mountains/windows-helper</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.3233" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
